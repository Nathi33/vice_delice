{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;max-width:1100px;margin:auto;">

    {# =========================
       IMAGES
       ========================= #}
    <div>

        {% set mainImage = product.mainImageUrl %}

        {% if mainImage %}
            <img src="{{ mainImage }}"
                 style="width:100%;height:450px;object-fit:cover;border-radius:8px;">
        {% else %}
            <div style="width:100%;height:450px;background:#eee;display:flex;align-items:center;justify-content:center;">
                Pas d'image
            </div>
        {% endif %}

        {% if product.productImages|length > 1 %}
            <div style="display:flex;gap:10px;margin-top:10px;flex-wrap:wrap;">
                {% for image in product.productImages %}
                    <img src="{{ image.url }}"
                         style="width:80px;height:80px;object-fit:cover;border-radius:4px;border:1px solid #ddd;">
                {% endfor %}
            </div>
        {% endif %}

    </div>

    {# =========================
       INFOS PRODUIT
       ========================= #}
    <div>

        <h1>{{ product.name }}</h1>

        {% if product.price %}
            <h2 style="color:#15848F;">{{ product.price }} €</h2>
        {% endif %}

        {% if product.category %}
            <p style="color:#666;">
                Catégorie : {{ product.category.name }}
            </p>
        {% endif %}

        <div style="margin:20px 0;">
            {{ product.description|nl2br }}
        </div>

        {% if product.stock %}
            <p>Stock : {{ product.stock }}</p>
        {% endif %}

        {# =========================
           BOUTON PANIER (FIX)
           ========================= #}
        <button onclick="addToCart({{ product.id }})"
                style="padding:10px 20px;background:#6A1857;color:white;border:none;border-radius:6px;">
            Ajouter au panier
        </button>

    </div>

</div>

{# =========================
   PRODUITS SIMILAIRES
   ========================= #}

{% if product.category %}

    <h3 style="margin-top:50px;">Produits similaires</h3>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">

        <p style="grid-column:span 4;color:#666;">
            (on ajoutera les produits liés ensuite)
        </p>

    </div>

{% endif %}

{% endblock %}