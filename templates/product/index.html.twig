{% extends 'base.html.twig' %}

{% block title %}Catalogue produits{% endblock %}

{% block body %}

<h1>Catalogue produits</h1>

<div style="position:sticky;top:0;background:white;padding:15px;border-bottom:1px solid #ddd;z-index:10;">

    <form id="filterForm" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">

        <input type="text" id="search" placeholder="Rechercher un produit">

        <select id="category">
            <option value="">Toutes les catégories</option>
            {% for category in categories %}
                <option value="{{ category.slug }}">{{ category.name }}</option>
            {% endfor %}
        </select>

        <select id="sort">
            <option value="newest">Plus récents</option>
            <option value="price_asc">Prix croissant</option>
            <option value="price_desc">Prix décroissant</option>
        </select>

        <button type="button" id="resetFilters">Réinitialiser</button>

    </form>

</div>

<div id="productGrid"
     style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:20px;">
</div>

<div id="pagination" style="margin-top:30px;text-align:center;"></div>

<script>

let currentPage = 1;

function loadProducts(page = 1) {

    currentPage = page;

    const category = document.getElementById('category').value;
    const sort = document.getElementById('sort').value;
    const search = document.getElementById('search').value;

    fetch(`/products/ajax?page=${page}&category=${category}&sort=${sort}&search=${search}`)
        .then(r => r.json())
        .then(data => {

            const grid = document.getElementById('productGrid');
            grid.innerHTML = '';

            data.products.forEach(p => {

                grid.innerHTML += `
                    <div style="border:1px solid #ddd;padding:10px;border-radius:6px;">

                        ${p.image ? `
                            <img src="${p.image}"
                                 style="width:100%;height:200px;object-fit:cover;margin-bottom:10px;">
                        ` : `
                            <div style="width:100%;height:200px;background:#eee;margin-bottom:10px;display:flex;align-items:center;justify-content:center;">
                                Pas d'image
                            </div>
                        `}

                        <h3>${p.name}</h3>

                        ${p.price ? `<p><strong>${p.price} €</strong></p>` : ''}

                        <a href="/product/${p.slug}">Voir</a>

                    </div>
                `;
            });

            renderPagination(data.currentPage, data.totalPages);
        });
}

function renderPagination(current, total) {

    let html = '';

    const start = Math.max(1, current - 2);
    const end = Math.min(total, current + 2);

    if (current > 1) {
        html += `<button onclick="loadProducts(${current - 1})">←</button>`;
    }

    for (let i = start; i <= end; i++) {
        html += i === current
            ? `<strong style="margin:0 5px;">${i}</strong>`
            : `<button onclick="loadProducts(${i})">${i}</button>`;
    }

    if (current < total) {
        html += `<button onclick="loadProducts(${current + 1})">→</button>`;
    }

    document.getElementById('pagination').innerHTML = html;
}

document.getElementById('category').addEventListener('change', () => loadProducts(1));
document.getElementById('sort').addEventListener('change', () => loadProducts(1));
document.getElementById('search').addEventListener('input', () => loadProducts(1));

document.getElementById('resetFilters').addEventListener('click', () => {
    document.getElementById('category').value = '';
    document.getElementById('sort').value = 'newest';
    document.getElementById('search').value = '';
    loadProducts(1);
});

loadProducts(1);

</script>

{% endblock %}