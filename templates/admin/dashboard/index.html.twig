{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord Admin{% endblock %}

{% block body %}

<div class="admin-dashboard">

{# =========================
   EN-TÊTE
   ========================= #}

<div class="admin-page-header">

    <div>
        <p class="admin-eyebrow">
            Vice &amp; Délice
        </p>

        <h1>
            Tableau de Bord
        </h1>

        <p>
            Vue d'ensemble de votre boutique.
        </p>
    </div>

</div>


{# =========================
   STATISTIQUES
   ========================= #}

<div class="admin-stats-grid">

    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            <i class="bi bi-bag-check"></i>
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Commandes
            </span>

            <strong class="admin-stat-value">
                {{ totalOrders }}
            </strong>

        </div>

    </div>


    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            <i class="bi bi-credit-card"></i>
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Commandes payées
            </span>

            <strong class="admin-stat-value">
                {{ paidOrdersCount }}
            </strong>

        </div>

    </div>


    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            <i class="bi bi-currency-euro"></i>
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Chiffre d'affaires
            </span>

            <strong class="admin-stat-value">
                {{ revenue|number_format(2, ',', ' ') }} €
            </strong>

        </div>

    </div>


    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            <i class="bi bi-box-seam"></i>
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Produits
            </span>

            <strong class="admin-stat-value">
                {{ productsCount }}
            </strong>

        </div>

    </div>

</div>


{# =========================
   ACTIONS RAPIDES
   ========================= #}

<section class="admin-section">

    <div class="admin-section-header">

        <div>
            <p class="admin-eyebrow">
                Gestion
            </p>

            <h2>
                Actions rapides
            </h2>
        </div>

    </div>


    <div class="admin-actions">

        <a href="{{ path('admin_orders_index') }}"
           class="admin-action-card">

            <span class="admin-action-icon">
                <i class="bi bi-receipt"></i>
            </span>

            <span>
                Voir les commandes
            </span>

            <i class="bi bi-arrow-right admin-action-arrow"></i>

        </a>


        <a href="{{ path('admin_product_index') }}"
           class="admin-action-card">

            <span class="admin-action-icon">
                <i class="bi bi-box-seam"></i>
            </span>

            <span>
                Gérer les produits
            </span>

            <i class="bi bi-arrow-right admin-action-arrow"></i>

        </a>


        <a href="{{ path('admin_category_index') }}"
           class="admin-action-card">

            <span class="admin-action-icon">
                <i class="bi bi-grid"></i>
            </span>

            <span>
                Gérer les catégories
            </span>

            <i class="bi bi-arrow-right admin-action-arrow"></i>

        </a>

    </div>

</section>


{# =========================
   DERNIÈRES COMMANDES
   ========================= #}

<section class="admin-section">

    <div class="admin-section-header">

        <div>
            <p class="admin-eyebrow">
                Activité
            </p>

            <h2>
                Dernières commandes
            </h2>
        </div>

        <a href="{{ path('admin_orders_index') }}"
           class="admin-section-link">
            Voir toutes les commandes
            <i class="bi bi-arrow-right"></i>
        </a>

    </div>


    <div class="admin-table-card">

        <div class="admin-table-wrapper">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    {% for order in latestOrders %}

                        <tr>

                            <td>
                                <span class="admin-order-id">
                                    #{{ order.id }}
                                </span>
                            </td>

                            <td>
                                <span class="admin-client-name">
                                    {{ order.firstName }}
                                    {{ order.lastName }}
                                </span>
                            </td>

                            <td>
                                <strong>
                                    {{ order.total }} €
                                </strong>
                            </td>

                            <td>

                                {% if order.status == 'paid' %}

                                    <span class="admin-status admin-status-paid">
                                        Payée
                                    </span>

                                {% elseif order.status == 'pending' %}

                                    <span class="admin-status admin-status-pending">
                                        En attente
                                    </span>

                                {% elseif order.status == 'shipped' %}

                                    <span class="admin-status admin-status-shipped">
                                        Expédiée
                                    </span>

                                {% elseif order.status == 'cancelled' %}

                                    <span class="admin-status admin-status-cancelled">
                                        Annulée
                                    </span>

                                {% endif %}

                            </td>

                            <td>
                                <span class="admin-date">
                                    {{ order.createdAt|date('d/m/Y H:i') }}
                                </span>
                            </td>

                            <td class="admin-table-action">

                                <a href="{{ path('admin_orders_show', {id: order.id}) }}">
                                    Voir
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="6" class="admin-empty">
                                Aucune commande pour le moment.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</section>

</div>

{% endblock %}
