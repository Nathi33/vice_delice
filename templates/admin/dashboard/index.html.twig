{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}

<div style="max-width:1400px;margin:auto;">

    <h1 style="margin-bottom:30px;">
        Dashboard Admin
    </h1>

    {# =========================
       STATS
       ========================= #}

    <div style="
        display:grid;
        grid-template-columns:repeat(4,1fr);
        gap:20px;
        margin-bottom:40px;
    ">

        <div style="
            background:white;
            border:1px solid #ddd;
            border-radius:10px;
            padding:25px;
        ">
            <h3>Commandes</h3>

            <p style="
                font-size:32px;
                font-weight:bold;
                margin-top:15px;
            ">
                {{ totalOrders }}
            </p>
        </div>

        <div style="
            background:white;
            border:1px solid #ddd;
            border-radius:10px;
            padding:25px;
        ">
            <h3>Commandes payées</h3>

            <p style="
                font-size:32px;
                font-weight:bold;
                margin-top:15px;
                color:green;
            ">
                {{ paidOrdersCount }}
            </p>
        </div>

        <div style="
            background:white;
            border:1px solid #ddd;
            border-radius:10px;
            padding:25px;
        ">
            <h3>Chiffre d'affaires</h3>

            <p style="
                font-size:32px;
                font-weight:bold;
                margin-top:15px;
                color:#6A1857;
            ">
                {{ revenue|number_format(2, ',', ' ') }} €
            </p>
        </div>

        <div style="
            background:white;
            border:1px solid #ddd;
            border-radius:10px;
            padding:25px;
        ">
            <h3>Produits</h3>

            <p style="
                font-size:32px;
                font-weight:bold;
                margin-top:15px;
            ">
                {{ productsCount }}
            </p>
        </div>

    </div>

    {# =========================
       ACTIONS RAPIDES
       ========================= #}

    <div style="
        display:flex;
        gap:20px;
        margin-bottom:40px;
    ">

        <a href="{{ path('admin_orders_index') }}"
           style="
                padding:14px 22px;
                background:#15848F;
                color:white;
                text-decoration:none;
                border-radius:8px;
                font-weight:bold;
           ">
            Voir les commandes
        </a>

        <a href="{{ path('admin_product_index') }}"
            style="
                padding:14px 22px;
                background:#6A1857;
                color:white;
                text-decoration:none;
                border-radius:8px;
                font-weight:bold;
            ">
                Gérer les produits
        </a>

        <a href="{{ path('admin_category_index') }}"
            style="
                padding:14px 22px;
                background:#333;
                color:white;
                text-decoration:none;
                border-radius:8px;
                font-weight:bold;
            ">
                Gérer les catégories
        </a>

        <a href="{{ path('admin_brand_index') }}"
            style="
                padding:14px 22px;
                background:#333;
                color:white;
                text-decoration:none;
                border-radius:8px;
                font-weight:bold;
            ">
            Gérer les marques
        </a>

    </div>

    {# =========================
       DERNIÈRES COMMANDES
       ========================= #}

    <div style="
        background:white;
        border:1px solid #ddd;
        border-radius:10px;
        padding:20px;
    ">

        <h2 style="margin-bottom:20px;">
            Dernières commandes
        </h2>

        <table width="100%" cellpadding="12">

            <thead style="background:#f5f5f5;">

                <tr>
                    <th align="left">ID</th>
                    <th align="left">Client</th>
                    <th align="left">Total</th>
                    <th align="left">Statut</th>
                    <th align="left">Date</th>
                    <th align="left"></th>
                </tr>

            </thead>

            <tbody>

                {% for order in latestOrders %}

                    <tr style="border-bottom:1px solid #eee;">

                        <td>#{{ order.id }}</td>

                        <td>
                            {{ order.firstName }}
                            {{ order.lastName }}
                        </td>

                        <td>
                            {{ order.total }} €
                        </td>

                        <td>

                            {% if order.status == 'paid' %}
                                <span style="color:green;font-weight:bold;">
                                    Payée
                                </span>

                            {% elseif order.status == 'pending' %}
                                <span style="color:orange;font-weight:bold;">
                                    En attente
                                </span>

                            {% elseif order.status == 'shipped' %}
                                <span style="color:blue;font-weight:bold;">
                                    Expédiée
                                </span>

                            {% elseif order.status == 'cancelled' %}
                                <span style="color:red;font-weight:bold;">
                                    Annulée
                                </span>
                            {% endif %}

                        </td>

                        <td>
                            {{ order.createdAt|date('d/m/Y H:i') }}
                        </td>

                        <td>
                            <a href="{{ path('admin_orders_show', {id: order.id}) }}">
                                Voir
                            </a>
                        </td>

                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

</div>

{% endblock %}