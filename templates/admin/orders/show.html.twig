{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.id }}{% endblock %}

{% block body %}

<h1>Commande #{{ order.id }}</h1>

<p><strong>Client :</strong> {{ order.firstName }} {{ order.lastName }}</p>
<p><strong>Email :</strong> {{ order.email }}</p>
<p><strong>Adresse :</strong> {{ order.address }}, {{ order.postalCode }} {{ order.city }}</p>
<p><strong>Total :</strong> {{ order.total }} €</p>
<p><strong>Status :</strong> {{ order.status }}</p>

<hr>

<h2>Produits</h2>

<ul>
    {% for item in order.items %}
        <li>
            {{ item.productName }} x{{ item.quantity }} - {{ item.price }} €
        </li>
    {% endfor %}
</ul>

<hr>

<h2>Changer statut</h2>

<form method="POST" action="{{ path('admin_orders_status', {id: order.id}) }}">
    <select name="status">
        <option value="pending" {% if order.status == 'pending' %}selected{% endif %}>Pending</option>
        <option value="paid" {% if order.status == 'paid' %}selected{% endif %}>Paid</option>
        <option value="shipped" {% if order.status == 'shipped' %}selected{% endif %}>Shipped</option>
        <option value="cancelled" {% if order.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
    </select>

    <button type="submit">Mettre à jour</button>
</form>

{% endblock %}