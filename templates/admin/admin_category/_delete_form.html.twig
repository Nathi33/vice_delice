
<div class="admin-category-delete-wrapper">

    <button
        type="button"
        class="admin-category-delete-action"
        onclick="document.getElementById('deleteCategoryModal').showModal()"
    >
        <i class="bi bi-trash3"></i>
        Supprimer
    </button>

    <dialog id="deleteCategoryModal" class="admin-delete-modal">

        <div class="admin-delete-modal-content">

            <div class="admin-delete-modal-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <h2>Confirmer la suppression</h2>

            <p>
                Voulez-vous vraiment supprimer cette catégorie ?
            </p>

            <p class="admin-delete-modal-warning">
                Cette action peut être irréversible.
            </p>

            <div class="admin-delete-modal-actions">

                <button
                    type="button"
                    class="admin-delete-cancel-action"
                    onclick="document.getElementById('deleteCategoryModal').close()"
                >
                    Annuler
                </button>

                <form
                    method="post"
                    action="{{ path('admin_category_delete', {'id': category.id}) }}"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('delete' ~ category.id) }}"
                    >

                    <button type="submit" class="admin-delete-confirm-action">
                        <i class="bi bi-trash3"></i>
                        Confirmer la suppression
                    </button>
                </form>

            </div>

        </div>

    </dialog>

</div>
