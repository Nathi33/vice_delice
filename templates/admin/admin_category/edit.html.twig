{% extends 'base.html.twig' %}

{% block title %}Modifier une catégorie{% endblock %}

{% block body %}

<div class="admin-dashboard">

    <div class="admin-page-header admin-product-page-header">

        <div class="admin-product-back">
            <a href="{{ path('admin_category_index') }}"
               class="account-back-link">
                <i class="bi bi-arrow-left me-2"></i>
                Retour aux catégories
            </a>
        </div>

        <div class="admin-product-title">
            <p class="admin-eyebrow">Catalogue</p>
            <h1>Modifier une catégorie</h1>
            <p>Modifiez les informations de votre catégorie.</p>
        </div>

    </div>

    <div class="admin-category-form-card">

        {{ include('admin/admin_category/_form.html.twig', {
            'button_label': 'Enregistrer les modifications'
        }) }}

    </div>
</div>

{% endblock %}
