{% extends 'base.html.twig' %}

{% block title %}Modifier produit{% endblock %}

{% block body %}

<div class="admin-dashboard">

    {# =========================
       EN-TÊTE
       ========================= #}

    <div class="admin-page-header admin-product-edit-header">

        <div class="mb-4">

            <a href="{{ path('admin_product_index') }}"
               class="account-back-link">

                <i class="bi bi-arrow-left me-2"></i>
                Retour aux produits

            </a>

        </div>

        <div>

            <p class="admin-eyebrow">
                Catalogue
            </p>

            <h1>
                Modifier le produit
            </h1>

            <p>
                Modifiez les informations et les images de ce produit.
            </p>

        </div>

    </div>


    {# =========================
       MESSAGES
       ========================= #}

    {% for message in app.flashes('success') %}

        <div style="color:green;margin-bottom:15px;">
            {{ message }}
        </div>

    {% endfor %}


    {% for message in app.flashes('error') %}

        <div style="color:red;margin-bottom:15px;">
            {{ message }}
        </div>

    {% endfor %}


    {# =========================
       FORMULAIRE + IMAGES
       ========================= #}

    {{ include('admin/admin_product/_edit_form.html.twig', {
        button_label: 'Mettre à jour'
    }) }}


</div>

{% endblock %}