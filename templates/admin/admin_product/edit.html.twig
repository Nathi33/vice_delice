{% extends 'base.html.twig' %}

{% block title %}Modifier produit{% endblock %}

{% block body %}

<h1>Modifier le produit</h1>

{# =========================
   FLASH MESSAGES
   ========================= #}

{% for message in app.flashes('success') %}
    <div style="color:green;margin-bottom:15px;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div style="color:red;margin-bottom:15px;">
        {{ message }}
    </div>
{% endfor %}

{# =========================
   FORMULAIRE
   ========================= #}

{{ include('admin/admin_product/_form.html.twig', {
    button_label: 'Mettre à jour'
}) }}

<br>

<a href="{{ path('admin_product_index') }}">
    ← Retour à la liste
</a>

<hr>

{# =========================
   IMAGES PRODUIT
   ========================= #}

<h2>Images du produit</h2>

{% if product.productImages|length > 0 %}

    <div style="display:flex;gap:20px;flex-wrap:wrap;">

        {% for image in product.productImages %}

            <div style="
                width:220px;
                border:1px solid #ddd;
                border-radius:10px;
                padding:10px;
            ">

                <img
                    src="{{ image.url }}"
                    alt=""
                    style="
                        width:100%;
                        height:180px;
                        object-fit:cover;
                        border-radius:8px;
                    "
                >

                <div style="margin-top:10px;">

                    {% if image.isMain %}

                        <p style="
                            color:green;
                            font-weight:bold;
                            margin-bottom:10px;
                        ">
                            Image principale
                        </p>

                    {% else %}

                        <form
                            method="POST"
                            action="{{ path('admin_product_image_main', {id: image.id}) }}"
                        >

                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('main_image' ~ image.id) }}"
                            >

                            <button type="submit">
                                Définir principale
                            </button>

                        </form>

                    {% endif %}

                    <form
                        method="POST"
                        action="{{ path('admin_product_image_delete', {id: image.id}) }}"
                        onsubmit="return confirm('Supprimer cette image ?');"
                    >

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('delete_image' ~ image.id) }}"
                        >

                        <button
                            type="submit"
                            style="
                                margin-top:10px;
                                color:red;
                            "
                        >
                            Supprimer
                        </button>

                    </form>

                </div>

            </div>

        {% endfor %}

    </div>

{% else %}

    <p>Aucune image pour ce produit.</p>

{% endif %}

<hr>

{# =========================
   DELETE PRODUCT
   ========================= #}

{{ include('admin/admin_product/_delete_form.html.twig') }}

{% endblock %}