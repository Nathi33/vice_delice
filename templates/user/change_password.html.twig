{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe — Vice & Délice{% endblock %}

{% block body %}

<section class="py-5">

    <div class="container">

        <div class="mb-4">
            <a href="{{ path('app_account') }}" class="account-back-link">
                <i class="bi bi-arrow-left me-2"></i>
                Retour à mon compte
            </a>
        </div>

        <div class="text-center mb-5">

            <p class="hero-subtitle mb-2">
                Sécurité du compte
            </p>

            <h1 class="section-title mb-3">
                Modifier mon mot de passe
            </h1>

            <p class="hero-description account-description">
                Modifiez votre mot de passe pour sécuriser votre compte.
            </p>

        </div>

        <div class="row justify-content-center">

            <div class="col-12 col-md-8 col-lg-6">

                <div class="product-card p-4 p-md-5">

                    {{ form_start(form) }}

                        <div class="mb-4">
                            {{ form_label(form.currentPassword, null, {
                                label_attr: {
                                    class: 'form-label text-light mb-2'
                                }
                            }) }}

                            <div class="password-wrapper">
                                {{ form_widget(form.currentPassword) }}

                                <button
                                    type="button"
                                    class="password-toggle"
                                    onclick="togglePassword(this)"
                                    aria-label="Afficher le mot de passe"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <div class="text-danger small mt-1">
                                {{ form_errors(form.currentPassword) }}
                            </div>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.newPassword.first, null, {
                                label_attr: {
                                    class: 'form-label text-light mb-2'
                                }
                            }) }}

                            <div class="password-wrapper">
                                {{ form_widget(form.newPassword.first) }}

                                <button
                                    type="button"
                                    class="password-toggle"
                                    onclick="togglePassword(this)"
                                    aria-label="Afficher le mot de passe"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <p class="footer-text small mt-2 mb-0">
                                12 caractères minimum, avec une majuscule,
                                une minuscule, un chiffre et un caractère spécial.
                            </p>

                            <div class="text-danger small mt-1">
                                {{ form_errors(form.newPassword.first) }}
                            </div>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.newPassword.second, null, {
                                label_attr: {
                                    class: 'form-label text-light mb-2'
                                }
                            }) }}

                            <div class="password-wrapper">
                                {{ form_widget(form.newPassword.second) }}

                                <button
                                    type="button"
                                    class="password-toggle"
                                    onclick="togglePassword(this)"
                                    aria-label="Afficher le mot de passe"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <div class="text-danger small mt-1">
                                {{ form_errors(form.newPassword.second) }}
                            </div>
                        </div>

                        <div class="text-center mt-4">

                            <button type="submit" class="btn-primary-custom">
                                <i class="bi bi-shield-check me-2"></i>
                                Modifier mon mot de passe
                            </button>

                        </div>

                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

</section>

{% block javascripts %}
<script>
function togglePassword(button) {
    const input = button.parentElement.querySelector('input');

    if (input.type === 'password') {
        input.type = 'text';
    } else {
        input.type = 'password';
    }
}
</script>
{% endblock %}

{% endblock %}