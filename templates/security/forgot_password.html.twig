{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — Vice & Délice{% endblock %}

{% block body %}

<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-8">

                <div class="auth-card p-4 p-lg-5">

                    <div class="text-center mb-4">

                        <p class="hero-subtitle mb-2">
                            Espace client
                        </p>

                        <h1 class="section-title mb-3">
                            Mot de passe oublié
                        </h1>

                        <p class="hero-description mb-0">
                            Entrez votre adresse email pour recevoir
                            un lien permettant de réinitialiser votre mot de passe.
                        </p>

                    </div>

                    <form method="post">

                        <div class="mb-4">

                            <label class="auth-label mb-2">
                                Adresse email
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="auth-input"
                                placeholder="Votre adresse email"
                                required
                                autocomplete="email"
                            >

                        </div>

                        <button
                            type="submit"
                            class="btn-primary-custom w-100"
                        >
                            Envoyer le lien
                        </button>

                    </form>

                    <div class="auth-separator my-4"></div>

                    <div class="text-center">

                        <a href="{{ path('app_login') }}" class="auth-link">
                            ← Retour à la connexion
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

{% endblock %}