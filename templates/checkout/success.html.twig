{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}

<div class="container py-5 checkout-success-page">

    <div class="checkout-success-header">

        <div class="checkout-success-icon">
            ✓
        </div>

        <p class="checkout-subtitle">Merci pour votre confiance</p>

        <h1 class="checkout-title">Commande confirmée 🎉</h1>

        <p class="checkout-success-intro">
            Votre commande a bien été enregistrée.
            Retrouvez ci-dessous le récapitulatif de votre commande.
        </p>

    </div>

    <div class="checkout-success-layout">

        <div class="checkout-card">

            <div class="checkout-card-header">
                <div>
                    <p class="checkout-order-label">Commande</p>
                    <h2>#{{ order.id }}</h2>
                </div>

                {% set statusLabels = {
                    'pending': 'En attente',
                    'paid': 'Payée',
                    'cancelled': 'Annulée',
                    'failed': 'Échec du paiement'
                } %}

                {% set statusClasses = {
                    'pending': 'status-pending',
                    'paid': 'status-paid',
                    'cancelled': 'status-cancelled',
                    'failed': 'status-failed'
                } %}

                <span class="checkout-status {{ statusClasses[order.status]|default('status-pending') }}">
                    {{ statusLabels[order.status]|default(order.status|capitalize) }}
                </span>
            </div>

            <div class="checkout-divider"></div>

            <h3 class="checkout-section-title">Votre commande</h3>

            <div class="checkout-order-items">

                {% for item in order.items %}

                    <div class="checkout-order-item">

                        <div class="checkout-order-item-info">
                            <strong>{{ item.productName }}</strong>
                            <span>Quantité : {{ item.quantity }}</span>
                        </div>

                        <strong>
                            {{ item.subtotal|number_format(2, ',', ' ') }} €
                        </strong>

                    </div>

                {% endfor %}

            </div>

            <div class="checkout-divider"></div>

            <div class="checkout-total checkout-success-total">
                <span>Total</span>
                <strong>
                    {{ order.total|number_format(2, ',', ' ') }} €
                </strong>
            </div>

        </div>


        <aside class="checkout-summary">

            <h2>Livraison</h2>

            <div class="summary-divider"></div>

            <div class="checkout-delivery">

                <strong>
                    {{ order.firstName }} {{ order.lastName }}
                </strong>

                <p>
                    {{ order.address }}<br>
                    {{ order.postalCode }} {{ order.city }}
                </p>

                <p class="checkout-delivery-email">
                    {{ order.email }}
                </p>

            </div>

            <div class="summary-divider"></div>

            <p class="checkout-summary-note">
                Votre commande sera préparée avec soin.
                Vous recevrez les informations nécessaires concernant son suivi.
            </p>

        </aside>

    </div>

    <div class="checkout-success-actions">

        <a href="{{ path('product_index') }}" class="btn-primary-custom">
            Continuer mes achats
        </a>

    </div>

</div>

{% endblock %}
